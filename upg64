#!/bin/bash
# upg64 - upgrade kernel a02_64 ke upstream stable 4.14.x (merge via patch)
#
# Pemakaian (jalankan dari root repo a02_64):
#   ./upg64            upgrade ke versi 4.14.205
#   ./upg64 205        sama seperti di atas
#   ./upg64 200        upgrade ke 4.14.200
#
# Hasil:
#   - branch baru  : upgrade-4.14.<target>  (branch asal tidak disentuh)
#   - 1 commit     : "Merge upstream v4.14.<cur> -> v4.14.<target> (patch)"
#   - daftar .rej  : upgrade_rej/ (hunk yang gagal, dicek manual) + upgrade_rej_list.txt
#   - patch        : upgrade_4.14.<cur>_to_<target>.patch
#
# Catatan: ini sama seperti cara di build_incremental.yml (branch incre),
# bedanya arch/arm diganti arch/arm64 karena tree ini 64-bit.
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

TARGET="${1:-205}"
PATHS=(arch/arm64/ drivers/ include/ kernel/ mm/ net/ sound/ Makefile)

die() { echo "ERROR: $*" >&2; exit 1; }

[ -f Makefile ] || die "Makefile tidak ada, jalankan dari root kernel."
git rev-parse --git-dir >/dev/null 2>&1 || die "Bukan git repo."

VERSION=$(sed -n 's/^VERSION *= *//p' Makefile | head -1)
PATCHLEVEL=$(sed -n 's/^PATCHLEVEL *= *//p' Makefile | head -1)
CURRENT=$(sed -n 's/^SUBLEVEL *= *//p' Makefile | head -1)
[ "$VERSION.$PATCHLEVEL" = "4.14" ] || die "Kernel bukan 4.14 (terdeteksi $VERSION.$PATCHLEVEL)."
[ "$TARGET" -gt "$CURRENT" ] || die "Target ($TARGET) harus lebih besar dari versi sekarang ($CURRENT)."

echo ">> Kernel sekarang : 4.14.$CURRENT"
echo ">> Target upgrade  : 4.14.$TARGET"

# working tree harus bersih (out/ sudah di-ignore)
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        die "Ada perubahan yang belum di-commit. Commit atau stash dulu."
fi

BASE_BRANCH=$(git rev-parse --abbrev-ref HEAD)
NEW_BRANCH="upgrade-4.14.$TARGET"
git rev-parse --verify -q "$NEW_BRANCH" >/dev/null && die "Branch $NEW_BRANCH sudah ada. Hapus dulu: git branch -D $NEW_BRANCH"

# --- fetch tag stable (kernel.org, cadangan mirror GitHub) ---
fetch_tags() {
        git remote remove stable 2>/dev/null || true
        git remote add stable "$1"
        git fetch stable tag "v4.14.$CURRENT" tag "v4.14.$TARGET" --no-tags --depth 1
}

OK=0
for i in 1 2 3; do
        echo ">> Fetch dari git.kernel.org (percobaan $i)..."
        if fetch_tags https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux-stable.git; then OK=1; break; fi
        sleep 10
done
if [ "$OK" -eq 0 ]; then
        echo ">> kernel.org gagal, coba mirror GitHub (gregkh/linux)..."
        fetch_tags https://github.com/gregkh/linux.git && OK=1
fi
[ "$OK" -eq 1 ] || die "Tag v4.14.$CURRENT / v4.14.$TARGET tidak berhasil di-fetch."

# --- bikin patch upstream ---
PATCH_FILE="upgrade_4.14.${CURRENT}_to_${TARGET}.patch"
git diff "v4.14.$CURRENT" "v4.14.$TARGET" -- "${PATHS[@]}" > "$PATCH_FILE" || die "git diff gagal."
echo ">> Patch: $PATCH_FILE ($(wc -l < "$PATCH_FILE") baris)"

# --- branch baru + apply ---
git checkout -q -b "$NEW_BRANCH" || die "Gagal bikin branch $NEW_BRANCH."

rm -rf upgrade_rej upgrade_rej_list.txt
# exit code patch != 0 itu wajar (banyak hunk sudah ada di tree vendor)
patch -p1 --forward --batch --no-backup-if-mismatch < "$PATCH_FILE"
echo ">> Exit code patch: $?"

# --- kumpulkan .rej ---
mkdir -p upgrade_rej
find . -path ./out -prune -o -name "*.rej" -print | sed 's|^\./||' | sort > upgrade_rej_list.txt
while read -r f; do
        [ -n "$f" ] || continue
        mkdir -p "upgrade_rej/$(dirname "$f")"
        mv "$f" "upgrade_rej/$f"
done < upgrade_rej_list.txt
REJ_COUNT=$(wc -l < upgrade_rej_list.txt)

# pastikan Makefile benar-benar ke versi target
NEWSUB=$(sed -n 's/^SUBLEVEL *= *//p' Makefile | head -1)
if [ "$NEWSUB" != "$TARGET" ]; then
        echo ">> WARNING: SUBLEVEL di Makefile = $NEWSUB (bukan $TARGET). Cek upgrade_rej/Makefile.rej"
fi

# --- commit (patch & laporan tidak ikut) ---
git add -A -- . ':!upgrade_rej' ':!upgrade_rej_list.txt' ":!$PATCH_FILE"
git commit -q -m "Merge upstream v4.14.$CURRENT -> v4.14.$TARGET (patch)" \
        -m "Hunk gagal: $REJ_COUNT file (lihat upgrade_rej_list.txt)" || echo ">> (tidak ada perubahan untuk di-commit)"

echo
echo "=============== SELESAI ==============="
echo "Branch asal       : $BASE_BRANCH"
echo "Branch upgrade    : $NEW_BRANCH"
echo "Versi Makefile    : 4.14.$NEWSUB"
echo "File dengan .rej  : $REJ_COUNT (lihat upgrade_rej_list.txt)"
echo "Lanjut: perbaiki .rej kalau perlu, lalu ./z64 untuk build."
echo "Batal : git checkout $BASE_BRANCH && git branch -D $NEW_BRANCH"
